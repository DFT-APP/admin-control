# Base URL of the DFT backend API. No trailing slash — apiClient appends paths
# that already start with "/".
#
# Vite inlines this into the JavaScript bundle at build time, so it is public
# once the panel is served. Never put a secret in a VITE_ variable.
#
# Local backend default (backend/.env PORT=3000):
VITE_API_URL=http://localhost:3000

# Pointing this at the production API means every action you take in the dev
# server — deleting a user, adjusting a wallet, approving an analyst — happens
# to real data. Use a local or staging backend unless you mean it.
# VITE_API_URL=https://api.dft.market

# "I'm a human" check on log in (Cloudflare Turnstile). A site key is public by
# design; the matching secret lives only in backend/.env (TURNSTILE_SECRET_KEY,
# with this panel's origin in TURNSTILE_ORIGINS). Unset, the check is not shown
# and the API must not list this origin, or every log in is refused.
#
# Cloudflare's always-pass test key, for local development:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=
